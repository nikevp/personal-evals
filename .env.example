# Required. Bills the model-backed communications sidecar and the RewardKit
# judges, and serves as the default credential for Claude agents.
ANTHROPIC_API_KEY=

# Optional: run Claude Code agents on a Claude subscription instead of the API
# key. Get a token with `claude setup-token`; set CLAUDE_FORCE_OAUTH=1 so the
# subscription is preferred when both credentials are present. The sidecar and
# judges still bill ANTHROPIC_API_KEY.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_FORCE_OAUTH=1

# Optional: run codex agents on a ChatGPT subscription. With
# CODEX_FORCE_AUTH_JSON=1, harbor injects your ChatGPT-login ~/.codex/auth.json
# into the agent container (log in first with `codex login`).
CODEX_FORCE_AUTH_JSON=1

# Optional world knobs (defaults shown; set in the shell or here).
# SIDECAR_MODEL picks the model that role-plays vendors and the owner.
# SIDECAR_QUOTE_SEED seeds the random vendor quote amounts drawn from each
# category's configured price band, so runs are reproducible; change it to get
# a different (still deterministic) set of quotes.
# SIDECAR_MODEL=claude-sonnet-4-6
# SIDECAR_QUOTE_SEED=0
